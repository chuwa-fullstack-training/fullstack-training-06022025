doctype html
hmtl(lang='en')
head
    meta(charset='UTF-8')
    meta(name=name="viewport" content="width=device-width, initial-scale=1.0")
    title= Cool Home Page 
body 
    h1= Welcome to Nodejs tutorial
    form(action="/create-post" method="POST")
        input(type="text" name="title" placeholder="Enter your name")
        input(type="text" name="content")
        input(type="submit" value="submit")

    #output 

    script.         
        const params = new URLSearchParams(window.location.search);
        const title = params.get('title');
        const content = params.get('content');
        if (title || content) {
            document.getElementById('output').innerText =
                `Submitted Title: ${title || ''}, Content: ${content || ''}`;
        }


